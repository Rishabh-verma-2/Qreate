# Copy to .env (never commit .env). Only MONGODB_URI, CLOUDINARY_* and one LLM key are required.

# ── Application / CORS ─────────────────────────────────────────────────────
ENVIRONMENT=development  # production → requires JWT_SECRET_KEY, strict CORS
# JWT_SECRET_KEY=        # REQUIRED in production: 32+ random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
ALLOW_LOCALHOST_CORS=true
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── MongoDB Atlas (free M0 cluster) — also powers the job queue ────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=qreate

# ── Cloudinary (free plan) — hosts finished videos ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── LLM: set at least one. Tried in this order, falls through on failure ──
LLM_PROVIDER_ORDER=groq,openrouter,gemini,agnes,ollama
GROQ_API_KEY=            # free: https://console.groq.com/keys (Llama 3.3 70B)
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=      # free models: https://openrouter.ai/keys
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=          # free tier: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=         # self-hosted open-source, e.g. http://localhost:11434
OLLAMA_MODEL=llama3.1
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_CHAT_MODEL=agnes-2.5-flash

# ── Real stock footage (free keys — strongly recommended for quality) ──────
PIXABAY_API_KEY=         # https://pixabay.com/api/docs/ — log in, key is shown on the page (videos + photos)
UNSPLASH_ACCESS_KEY=     # https://unsplash.com/oauth/applications — New Application → Access Key (photos)
PEXELS_API_KEY=          # https://www.pexels.com/api/ (new keys currently paused)

# ── Visual matching (CLIP) — set false on hosts with < 2 GB RAM ─────────────
VISUAL_RERANK=true
CLIP_MODEL=ViT-B-32              # on a GPU worker: ViT-L-14 (more accurate)
CLIP_PRETRAINED=laion2b_s34b_b79k  # for ViT-L-14: laion2b_s32b_b82k
RERANK_MIN_SCORE=0.22

# ── Rendering ───────────────────────────────────────────────────────────────
X264_PRESET=veryfast
X264_CRF=21
SCENE_RENDER_PARALLELISM=2
ENABLE_MUSIC=true
MUSIC_VOLUME=0.16

# ── Queue / scaling ─────────────────────────────────────────────────────────
EMBEDDED_WORKER=true     # false on the API if you run separate `python -m app.worker` processes
JOB_QUEUE=qreate         # local dev sharing one MongoDB: use your own, e.g. qreate-yourname
WORKER_CONCURRENCY=1     # videos rendered at once per process
MAX_QUEUE_DEPTH=200
MAX_BATCH_SIZE=25
RATE_LIMIT_VIDEOS_PER_HOUR=10   # per signed-in user (or IP)
RATE_LIMIT_SCRIPTS_PER_HOUR=20

# ── Qwen3 / vLLM (local AI Director LLM) ────────────────────────────────────
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_API_KEY=EMPTY
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_TOKENS=4096

# ── Video Engine ──────────────────────────────────────────────────────────────
VIDEO_ENGINE=wan            # wan | native (existing engine)
WAN_MODE=t2v                # t2v | i2v
WAN_MODEL_PATH=             # local path e.g. /models/Wan2.1-I2V-14B-480P or /models/Wan2.1-T2V-1.3B
WAN_MODEL_SIZE=1.3B         # 1.3B | 14B-480P | 14B-720P

# ── ComfyUI (preferred Wan2.1 backend) ───────────────────────────────────────
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_TIMEOUT_SECONDS=600

# ── GPU diagnostics ───────────────────────────────────────────────────────────
GPU_MIN_VRAM_GB=8.0         # warn if less VRAM than this

