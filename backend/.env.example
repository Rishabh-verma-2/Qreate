# ── Application ────────────────────────────────────────────────────────────
APP_NAME=Qreate
DEBUG=false

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── MongoDB Atlas ───────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=qreate

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Agnes AI ─────────────────────────────────────────────────────────────────
# Get your free API key from https://platform.agnes-ai.com
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com

# Agnes models (do not change unless Agnes releases new versions)
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
AGNES_CHAT_MODEL=agnes-2.5-flash
AGNES_VIDEO_SIZE=720P

# ── Polling config (seconds) ─────────────────────────────────────────────────
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_POLL_MAX_ATTEMPTS=120
VIDEO_QUEUE_RETRY_MAX_SECONDS=900
