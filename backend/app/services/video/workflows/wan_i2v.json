{
  "_comment": "Wan2.1 Image-to-Video ComfyUI workflow template. Placeholders: {{PROMPT}}, {{NEGATIVE_PROMPT}}, {{IMAGE_FILENAME}}, {{FRAMES}}, {{WIDTH}}, {{HEIGHT}}, {{FPS}}. Requires: ComfyUI-WanVideoWrapper or ComfyUI-Wan2.1 custom nodes.",
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{IMAGE_FILENAME}}"
    }
  },
  "2": {
    "class_type": "WanTextEncode",
    "inputs": {
      "positive": "{{PROMPT}}",
      "negative": "{{NEGATIVE_PROMPT}}"
    }
  },
  "3": {
    "class_type": "WanModelLoader",
    "inputs": {
      "model": "Wan2.1-I2V-14B-480P",
      "precision": "bf16"
    }
  },
  "4": {
    "class_type": "WanImageToVideoSampler",
    "inputs": {
      "model": ["3", 0],
      "conditioning": ["2", 0],
      "image": ["1", 0],
      "num_frames": "{{FRAMES}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "fps": "{{FPS}}",
      "steps": 20,
      "cfg": 6.0,
      "seed": -1
    }
  },
  "5": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["4", 0],
      "frame_rate": "{{FPS}}",
      "loop_count": 0,
      "filename_prefix": "wan_i2v",
      "format": "video/h264-mp4",
      "save_output": true
    }
  }
}
